<div
    class="form-field {{#if fieldClass}}{{fieldClass}}{{/if}}"
    data-form-field="{{name}}">

    {{#if label}}

        <label
            for="{{id}}"
            class="form-field__label">

            <span>
                {{label}}
            </span>

            {{#if required}}

                <span
                    class="form-field__required"
                    aria-hidden="true">
                    *
                </span>

            {{/if}}

        </label>

    {{/if}}

    <div class="form-field__control">

        <input
            type="{{#if type}}{{type}}{{else}}date{{/if}}"
            id="{{id}}"
            name="{{name}}"
            class="form-input form-input--date {{#if inputClass}}{{inputClass}}{{/if}}"
            value="{{value}}"

            {{#if min}}
                min="{{min}}"
            {{/if}}

            {{#if max}}
                max="{{max}}"
            {{/if}}

            {{#if step}}
                step="{{step}}"
            {{/if}}

            {{#if required}}
                required
                aria-required="true"
            {{/if}}

            {{#if readonly}}
                readonly
            {{/if}}

            {{#if disabled}}
                disabled
            {{/if}}

            {{#if error}}
                aria-invalid="true"
                aria-describedby="{{id}}Error"
            {{else if description}}
                aria-describedby="{{id}}Description"
            {{/if}}>

    </div>

    {{#if description}}

        <small
            id="{{id}}Description"
            class="form-field__description">
            {{description}}
        </small>

    {{/if}}

    <small
        id="{{id}}Error"
        class="form-field__error"
        data-field-error="{{name}}"
        {{#unless error}}hidden{{/unless}}>

        {{error}}

    </small>

</div>