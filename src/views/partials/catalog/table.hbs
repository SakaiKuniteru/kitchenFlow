<div
    class="catalog-table-wrapper {{#if wrapperClass}}{{wrapperClass}}{{/if}}"
    data-catalog-table-wrapper>

    <div
        class="catalog-table__loading"
        data-table-loading
        hidden>

        <span
            class="catalog-table__spinner"
            aria-hidden="true">
        </span>

        <span>
            Đang tải dữ liệu...
        </span>

    </div>

    <div class="catalog-table__scroll">

        <table
            id="{{#if tableId}}{{tableId}}{{else}}catalogTable{{/if}}"
            class="catalog-table {{#if tableClass}}{{tableClass}}{{/if}}"
            data-catalog-table>

            <thead class="catalog-table__head">

                <tr data-table-header-row>

                    {{#if selectable}}

                        <th
                            class="catalog-table__cell catalog-table__cell--checkbox"
                            scope="col">

                            <input
                                type="checkbox"
                                data-table-select-all
                                aria-label="Chọn tất cả dữ liệu">

                        </th>

                    {{/if}}

                    {{#if showIndex}}

                        <th
                            class="catalog-table__cell catalog-table__cell--index"
                            scope="col">

                            STT

                        </th>

                    {{/if}}

                    {{#each columns}}

                        <th
                            class="catalog-table__cell {{#if className}}{{className}}{{/if}}"
                            scope="col"
                            data-column-key="{{key}}"
                            {{#if width}}style="width: {{width}};"{{/if}}>

                            {{#if sortable}}

                                <button
                                    type="button"
                                    class="catalog-table__sort-button"
                                    data-sort-key="{{key}}"
                                    aria-label="Sắp xếp theo {{label}}">

                                    <span>
                                        {{label}}
                                    </span>

                                    {{> table/sort-icon}}

                                </button>

                            {{else}}

                                {{label}}

                            {{/if}}

                        </th>

                    {{/each}}

                    {{#if showActions}}

                        <th
                            class="catalog-table__cell catalog-table__cell--actions"
                            scope="col">

                            Thao tác

                        </th>

                    {{/if}}

                </tr>

                {{#if showFilterRow}}

                    {{> catalog/table-filter-row
                        columns=columns
                        selectable=selectable
                        showIndex=showIndex
                        showActions=showActions
                    }}

                {{/if}}

            </thead>

            <tbody
                id="{{#if tableBodyId}}{{tableBodyId}}{{else}}catalogTableBody{{/if}}"
                class="catalog-table__body"
                data-catalog-table-body>

                {{!--
                    Dữ liệu hoặc trạng thái rỗng
                    được render bằng table.js
                --}}

            </tbody>

        </table>

    </div>

</div>