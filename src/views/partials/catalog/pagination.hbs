<footer
    id="{{#if paginationId}}{{paginationId}}{{else}}catalogPagination{{/if}}"
    class="catalog-pagination"
    data-catalog-pagination>

    <div
        class="catalog-pagination__summary"
        aria-live="polite">

        <strong data-pagination-from>
            0
        </strong>

        <span aria-hidden="true">
            –
        </span>

        <strong data-pagination-to>
            0
        </strong>

        <span class="catalog-pagination__summary-divider">
            /
        </span>

        <strong data-pagination-total>
            0
        </strong>

        <span class="catalog-pagination__summary-label">
            bản ghi
        </span>

    </div>


    <div class="catalog-pagination__controls">

        <label class="catalog-pagination__page-size">

            <span class="catalog-pagination__page-size-label">
                Hiển thị
            </span>

            <span class="catalog-pagination__select-wrapper">

                <select
                    data-pagination-size
                    aria-label="Số bản ghi trên mỗi trang">

                    <option value="10">
                        10 dòng
                    </option>

                    <option
                        value="20"
                        selected>
                        20 dòng
                    </option>

                    <option value="50">
                        50 dòng
                    </option>

                    <option value="100">
                        100 dòng
                    </option>

                </select>

                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true">

                    <path d="m6 9 6 6 6-6"></path>

                </svg>

            </span>

        </label>


        <nav
            class="catalog-pagination__navigation"
            aria-label="Điều hướng phân trang">

            <button
                type="button"
                class="catalog-pagination__button"
                data-pagination-first
                aria-label="Trang đầu"
                title="Trang đầu"
                disabled>

                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true">

                    <path d="m11 17-5-5 5-5"></path>
                    <path d="m18 17-5-5 5-5"></path>

                </svg>

            </button>

            <button
                type="button"
                class="catalog-pagination__button"
                data-pagination-previous
                aria-label="Trang trước"
                title="Trang trước"
                disabled>

                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true">

                    <path d="m15 18-6-6 6-6"></path>

                </svg>

            </button>


            <div class="catalog-pagination__page-information">

                <span>
                    Trang
                </span>

                <strong data-pagination-current-page>
                    1
                </strong>

                <span>
                    /
                </span>

                <strong data-pagination-total-pages>
                    1
                </strong>

            </div>


            <button
                type="button"
                class="catalog-pagination__button"
                data-pagination-next
                aria-label="Trang tiếp theo"
                title="Trang tiếp theo"
                disabled>

                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true">

                    <path d="m9 18 6-6-6-6"></path>

                </svg>

            </button>

            <button
                type="button"
                class="catalog-pagination__button"
                data-pagination-last
                aria-label="Trang cuối"
                title="Trang cuối"
                disabled>

                <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true">

                    <path d="m6 17 5-5-5-5"></path>
                    <path d="m13 17 5-5-5-5"></path>

                </svg>

            </button>

        </nav>

    </div>

</footer>