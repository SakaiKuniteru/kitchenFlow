<section
    id="{{#if panelId}}{{panelId}}{{else}}detailPanelContent{{/if}}"
    class="detail-panel {{#if panelClass}}{{panelClass}}{{/if}}"
    data-detail-panel
    data-mode="{{#if mode}}{{mode}}{{else}}view{{/if}}">

    {{> catalog/detail-header
        title=title
        subtitle=subtitle
        showEditButton=showEditButton
        showCloseButton=showCloseButton
    }}

    <div class="detail-panel__body">

        <div
            class="detail-panel__placeholder"
            data-detail-placeholder>

            {{> common/empty-state
                emptyTitle="Chưa chọn dữ liệu"
                emptyDescription="Chọn một dòng trong danh sách để xem thông tin chi tiết."
            }}

        </div>

        <form
            id="{{#if formId}}{{formId}}{{else}}catalogForm{{/if}}"
            class="detail-panel__form"
            data-catalog-form
            autocomplete="off"
            novalidate
            hidden>

            <input
                type="hidden"
                id="{{formId}}Id"
                name="id"
                data-record-id>

            <div class="detail-panel__form-content">

                {{#if formPartial}}

                    {{> (lookup . "formPartial")}}

                {{else}}

                    <div class="catalog-page__notice">
                        Chưa cấu hình form cho danh mục này.
                    </div>

                {{/if}}

            </div>

            {{> catalog/form-actions}}

        </form>

    </div>

</section>