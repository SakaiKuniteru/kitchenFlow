<header
    class="detail-panel__header"
    data-detail-header>

    <div class="detail-panel__heading">

        <button
            type="button"
            class="detail-panel__back-button"
            data-detail-back
            aria-label="Quay lại danh sách"
            hidden>

            <span aria-hidden="true">
                ←
            </span>

        </button>

        <div class="detail-panel__heading-content">

            <h2
                class="detail-panel__title"
                data-detail-title>

                {{#if title}}

                    {{title}}

                {{else}}

                    Thông tin chi tiết

                {{/if}}

            </h2>

            <p
                class="detail-panel__subtitle"
                data-detail-subtitle
                {{#unless subtitle}}hidden{{/unless}}>

                {{subtitle}}

            </p>

        </div>

    </div>

    <div class="detail-panel__header-actions">

        {{#if showEditButton}}

            <button
                type="button"
                class="detail-panel__header-button"
                data-detail-edit
                aria-label="Cập nhật dữ liệu">

                <span aria-hidden="true">
                    ✎
                </span>

                <span>
                    Cập nhật
                </span>

            </button>

        {{/if}}

        <button
            type="button"
            class="detail-panel__header-button detail-panel__header-button--close"
            data-detail-close
            aria-label="Đóng bảng thông tin">

            <span aria-hidden="true">
                ×
            </span>

        </button>

    </div>

</header>