<aside
    class="
        thuc-don-menu-column
        thuc-don-menu-column--groups
    "
    data-groups-column>

    <header class="thuc-don-menu-column__header">

        <strong class="thuc-don-menu-column__title">
            Danh sách nhóm món
        </strong>

    </header>


    <div
        class="thuc-don-groups"
        data-groups-list>
    </div>

</aside>


<template id="template-thuc-don-group">

    <article
        class="thuc-don-group"
        data-group-item>

        <button
            type="button"
            class="thuc-don-group__main"
            data-select-group>

            <span
                class="
                    thuc-don-group__icon
                    is-green
                ">

                <i class="fa-solid fa-bowl-food"></i>

            </span>


            <span class="thuc-don-group__info">

                <strong data-group-name>
                    -
                </strong>

                <small data-group-count>
                    0 món
                </small>

            </span>


            <i
                class="
                    fa-solid
                    fa-chevron-right
                    thuc-don-group__arrow
                ">
            </i>

        </button>

    </article>

</template>