<aside
    class="
        thuc-don-menu-column
        thuc-don-menu-column--days
    "
    data-days-column>

    <header class="thuc-don-menu-column__header">

        <strong class="thuc-don-menu-column__title">
            Danh sách ngày
        </strong>


        <button
            type="button"
            class="thuc-don-form-action"
            data-add-day>

            <i class="fa-solid fa-plus"></i>

            <span>
                Thêm mới
            </span>

        </button>

    </header>


    <div
        class="thuc-don-days"
        data-days-list>
    </div>

    <div class="thuc-don-editor-bottom-action">

        <button
            type="button"
            class="thuc-don-editor-bottom-add"
            data-add-day
            title="Thêm ngày">

            <i class="fa-solid fa-plus"></i>

        </button>

    </div>

</aside>


<template id="template-thuc-don-day">

    <article
        class="thuc-don-day"
        data-day-item>

        <span class="thuc-don-day__point"></span>


        <button
            type="button"
            class="thuc-don-day__main"
            data-select-day>

            <span class="thuc-don-day__info">

                <strong data-day-date>
                    -
                </strong>

                <small data-day-weekday>
                    -
                </small>

            </span>


            <span class="thuc-don-day__right">

                <span
                    class="thuc-don-day__count"
                    data-day-count>
                    0 món
                </span>

            </span>

        </button>


        <div class="thuc-don-item-actions">

            <button
                type="button"
                class="thuc-don-item-action"
                data-save-day
                title="Lưu tạm">

                <i class="fa-regular fa-floppy-disk"></i>

            </button>


            <button
                type="button"
                class="thuc-don-item-action"
                data-edit-day
                title="Chỉnh sửa">

                <i class="fa-regular fa-pen-to-square"></i>

            </button>


            <button
                type="button"
                class="
                    thuc-don-item-action
                    is-danger
                "
                data-delete-day
                title="Xóa">

                <i class="fa-regular fa-trash-can"></i>

            </button>

        </div>

    </article>

</template>