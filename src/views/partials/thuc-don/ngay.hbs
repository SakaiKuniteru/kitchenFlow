<aside
    class="
        thuc-don-menu-column
        thuc-don-menu-column--days
    "
    data-days-column>

    <header class="thuc-don-menu-column__header">

        <strong class="thuc-don-menu-column__title">
            Danh sách ngày
        </strong>

    </header>


    <div
        class="thuc-don-days"
        data-days-list>
    </div>

</aside>


<template id="template-thuc-don-day">

    <article
        class="thuc-don-day"
        data-day-item>

        <span class="thuc-don-day__point"></span>


        <button
            type="button"
            class="thuc-don-day__main"
            data-select-day>

            <span class="thuc-don-day__info">

                <strong data-day-date>
                    -
                </strong>

                <small data-day-weekday>
                    -
                </small>

            </span>


            <span class="thuc-don-day__right">

                <span
                    class="thuc-don-day__count"
                    data-day-count>
                    0 món
                </span>


                <i class="fa-solid fa-chevron-right"></i>

            </span>

        </button>

    </article>

</template>