<main
    class="td03-page"
    data-td03-page>

    {{#> bao-cao/report-frame
        maBaoCao=maBaoCao
        tenBaoCao=tenBaoCao
    }}

        {{> forms/date
            id="tuNgay"
            name="tuNgay"
            label="Từ ngày áp dụng"
            placeholder="Nhập từ ngày..."
            defaultTime="00:00:00"
            showTime=true
            required=true
        }}


        {{> forms/date
            id="denNgay"
            name="denNgay"
            label="Đến ngày áp dụng"
            placeholder="Nhập đến ngày..."
            defaultTime="23:59:59"
            showTime=true
            required=true
        }}


        {{> forms/select
            id="coSoIds"
            name="coSoIds"
            label="Cơ sở"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn cơ sở..."
            options=null
        }}


        {{> forms/select
            id="nhaAnIds"
            name="nhaAnIds"
            label="Nhà ăn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn nhà ăn..."
            options=null
        }}


        {{> forms/select
            id="caAnIds"
            name="caAnIds"
            label="Ca ăn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn ca ăn..."
            options=null
        }}


        {{> forms/select
            id="nhomMonAnIds"
            name="nhomMonAnIds"
            label="Nhóm món"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn nhóm món..."
            options=null
        }}


        {{> forms/select
            id="monAnIds"
            name="monAnIds"
            label="Món ăn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn món ăn..."
            options=null
        }}


        {{> forms/number
            id="soLanXuatHienToiThieu"
            name="soLanXuatHienToiThieu"
            label="Số lần xuất hiện tối thiểu"
            placeholder="Nhập số lần..."
            min=1
            step=1
        }}

    {{/bao-cao/report-frame}}

</main>


<script
    defer
    src="{{asset "/assets/js/pages/bao-cao/thuc-don/td03.js" }}">
</script>