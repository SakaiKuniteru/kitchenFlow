<main
    class="td05-page"
    data-td05-page>

    {{#> bao-cao/report-frame
        maBaoCao=maBaoCao
        tenBaoCao=tenBaoCao
    }}

        {{> forms/select
            id="dotBinhChonIds"
            name="dotBinhChonIds"
            label="Đợt bình chọn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn đợt bình chọn..."
            options=null
        }}


        {{> forms/date
            id="tuNgay"
            name="tuNgay"
            label="Từ ngày áp dụng"
            placeholder="Nhập từ ngày..."
            defaultTime="00:00:00"
            showTime=true
            required=true
        }}


        {{> forms/date
            id="denNgay"
            name="denNgay"
            label="Đến ngày áp dụng"
            placeholder="Nhập đến ngày..."
            defaultTime="23:59:59"
            showTime=true
            required=true
        }}


        {{> forms/select
            id="coSoIds"
            name="coSoIds"
            label="Cơ sở"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn cơ sở..."
            options=null
        }}


        {{> forms/select
            id="nhaAnIds"
            name="nhaAnIds"
            label="Nhà ăn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn nhà ăn..."
            options=null
        }}


        {{> forms/select
            id="trangThaiDotBinhChon"
            name="trangThaiDotBinhChon"
            label="Trạng thái đợt bình chọn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn trạng thái..."
            options=null
        }}

    {{/bao-cao/report-frame}}

</main>


<script
    defer
    src="{{asset "/assets/js/pages/bao-cao/thuc-don/td05.js" }}">
</script>