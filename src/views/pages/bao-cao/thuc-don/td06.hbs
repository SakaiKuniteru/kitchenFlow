<main
    class="td06-page"
    data-td06-page>

    {{#> bao-cao/report-frame
        maBaoCao=maBaoCao
        tenBaoCao=tenBaoCao
    }}

        {{> forms/date
            id="tuNgay"
            name="tuNgay"
            label="Từ ngày áp dụng"
            placeholder="Nhập từ ngày..."
            defaultTime="00:00:00"
            showTime=true
            required=true
        }}


        {{> forms/date
            id="denNgay"
            name="denNgay"
            label="Đến ngày áp dụng"
            placeholder="Nhập đến ngày..."
            defaultTime="23:59:59"
            showTime=true
            required=true
        }}


        {{> forms/select
            id="coSoIds"
            name="coSoIds"
            label="Cơ sở"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn cơ sở..."
            options=null
        }}


        {{> forms/select
            id="nhaAnIds"
            name="nhaAnIds"
            label="Nhà ăn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn nhà ăn..."
            options=null
        }}


        {{> forms/select
            id="loaiThucDon"
            name="loaiThucDon"
            label="Loại thực đơn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn loại thực đơn..."
            options=null
        }}


        {{> forms/select
            id="trangThaiThucDon"
            name="trangThaiThucDon"
            label="Trạng thái"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn trạng thái..."
            options=null
        }}


        {{> forms/select
            id="nguoiLapIds"
            name="nguoiLapIds"
            label="Người lập"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn người lập..."
            options=null
        }}


        {{> forms/select
            id="nguoiDuyetIds"
            name="nguoiDuyetIds"
            label="Người duyệt"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn người duyệt..."
            options=null
        }}

    {{/bao-cao/report-frame}}

</main>


<script
    defer
    src="{{asset "/assets/js/pages/bao-cao/thuc-don/td06.js" }}">
</script>