<main
    class="va05-page"
    data-va05-page>

    {{#> bao-cao/report-frame
        maBaoCao=maBaoCao
        tenBaoCao=tenBaoCao
    }}

        {{> forms/date
            id="tuNgay"
            name="tuNgay"
            label="Từ ngày hủy"
            placeholder="Nhập từ ngày..."
            defaultTime="00:00:00"
            showTime=true
            required=true
        }}


        {{> forms/date
            id="denNgay"
            name="denNgay"
            label="Đến ngày hủy"
            placeholder="Nhập đến ngày..."
            defaultTime="23:59:59"
            showTime=true
            required=true
        }}


        {{> forms/select
            id="coSoIds"
            name="coSoIds"
            label="Cơ sở"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn cơ sở..."
            options=null
        }}


        {{> forms/select
            id="nhaAnIds"
            name="nhaAnIds"
            label="Nhà ăn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn nhà ăn..."
            options=null
        }}


        {{> forms/select
            id="caAnIds"
            name="caAnIds"
            label="Ca ăn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn ca ăn..."
            options=null
        }}


        {{> forms/select
            id="nhanVienIds"
            name="nhanVienIds"
            label="Nhân viên"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn nhân viên..."
            options=null
        }}


        {{> forms/select
            id="nguoiHuyIds"
            name="nguoiHuyIds"
            label="Người hủy"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn người hủy..."
            options=null
        }}


        {{> forms/input
            id="lyDoHuy"
            name="lyDoHuy"
            label="Lý do hủy"
            placeholder="Nhập lý do hủy..."
            maxlength=500
        }}

    {{/bao-cao/report-frame}}

</main>


<script
    defer
    src="{{asset "/assets/js/pages/bao-cao/ve-an/va05.js" }}">
</script>