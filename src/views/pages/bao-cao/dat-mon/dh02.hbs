<main
    class="dh02-page"
    data-dh02-page>

    {{#> bao-cao/report-frame
        maBaoCao=maBaoCao
        tenBaoCao=tenBaoCao
    }}

        {{> forms/select
            id="loaiThoiGian"
            name="loaiThoiGian"
            label="Loại thời gian"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn ngày đặt / ngày nhận dự kiến..."
            options=null
            required=true
        }}


        {{> forms/date
            id="tuNgay"
            name="tuNgay"
            label="Từ ngày"
            placeholder="Nhập từ ngày..."
            defaultTime="00:00:00"
            showTime=true
            required=true
        }}


        {{> forms/date
            id="denNgay"
            name="denNgay"
            label="Đến ngày"
            placeholder="Nhập đến ngày..."
            defaultTime="23:59:59"
            showTime=true
            required=true
        }}


        {{> forms/select
            id="coSoIds"
            name="coSoIds"
            label="Cơ sở"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn cơ sở..."
            options=null
        }}


        {{> forms/select
            id="nhaAnIds"
            name="nhaAnIds"
            label="Nhà ăn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn nhà ăn..."
            options=null
        }}


        {{> forms/input
            id="maDon"
            name="maDon"
            label="Mã đơn"
            placeholder="Nhập mã đơn..."
            maxlength=100
        }}


        {{> forms/select
            id="nguoiDatIds"
            name="nguoiDatIds"
            label="Người đặt"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn người đặt..."
            options=null
        }}


        {{> forms/select
            id="nguoiNhanIds"
            name="nguoiNhanIds"
            label="Người nhận"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn người nhận..."
            options=null
        }}


        {{> forms/select
            id="phongBanIds"
            name="phongBanIds"
            label="Phòng ban"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn phòng ban..."
            options=null
        }}


        {{> forms/select
            id="trangThaiDon"
            name="trangThaiDon"
            label="Trạng thái đơn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn trạng thái đơn..."
            options=null
        }}

    {{/bao-cao/report-frame}}

</main>


<script
    defer
    src="{{asset "/assets/js/pages/bao-cao/dat-mon/dh02.js" }}">
</script>