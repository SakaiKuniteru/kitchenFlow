<main
    class="dh06-page"
    data-dh06-page>

    {{#> bao-cao/report-frame
        maBaoCao=maBaoCao
        tenBaoCao=tenBaoCao
    }}

        {{> forms/date
            id="tuNgay"
            name="tuNgay"
            label="Từ ngày hủy / từ chối"
            placeholder="Nhập từ ngày..."
            defaultTime="00:00:00"
            showTime=true
            required=true
        }}


        {{> forms/date
            id="denNgay"
            name="denNgay"
            label="Đến ngày hủy / từ chối"
            placeholder="Nhập đến ngày..."
            defaultTime="23:59:59"
            showTime=true
            required=true
        }}


        {{> forms/select
            id="coSoIds"
            name="coSoIds"
            label="Cơ sở"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn cơ sở..."
            options=null
        }}


        {{> forms/select
            id="nhaAnIds"
            name="nhaAnIds"
            label="Nhà ăn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn nhà ăn..."
            options=null
        }}


        {{> forms/select
            id="nguoiDatIds"
            name="nguoiDatIds"
            label="Người đặt"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn người đặt..."
            options=null
        }}


        {{> forms/select
            id="nguoiThucHienIds"
            name="nguoiThucHienIds"
            label="Người thực hiện"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn người thực hiện..."
            options=null
        }}


        {{> forms/select
            id="loaiXuLy"
            name="loaiXuLy"
            label="Hình thức xử lý"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn hủy / từ chối..."
            options=null
        }}


        {{> forms/input
            id="lyDo"
            name="lyDo"
            label="Lý do"
            placeholder="Nhập nội dung lý do..."
            maxlength=500
        }}

    {{/bao-cao/report-frame}}

</main>


<script
    defer
    src="{{asset "/assets/js/pages/bao-cao/dat-mon/dh06.js" }}">
</script>