<main
    class="dh07-page"
    data-dh07-page>

    {{#> bao-cao/report-frame
        maBaoCao=maBaoCao
        tenBaoCao=tenBaoCao
    }}

        {{> forms/date
            id="tuNgay"
            name="tuNgay"
            label="Từ ngày đặt"
            placeholder="Nhập từ ngày..."
            defaultTime="00:00:00"
            showTime=true
            required=true
        }}


        {{> forms/date
            id="denNgay"
            name="denNgay"
            label="Đến ngày đặt"
            placeholder="Nhập đến ngày..."
            defaultTime="23:59:59"
            showTime=true
            required=true
        }}


        {{> forms/select
            id="coSoIds"
            name="coSoIds"
            label="Cơ sở"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn cơ sở..."
            options=null
        }}


        {{> forms/select
            id="nhaAnIds"
            name="nhaAnIds"
            label="Nhà ăn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn nhà ăn..."
            options=null
        }}


        {{> forms/select
            id="phongBanIds"
            name="phongBanIds"
            label="Phòng ban"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn phòng ban..."
            options=null
        }}


        {{> forms/select
            id="nhanVienIds"
            name="nhanVienIds"
            label="Nhân viên"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn nhân viên..."
            options=null
        }}


        {{> forms/select
            id="hinhThucDat"
            name="hinhThucDat"
            label="Hình thức đặt"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn đặt cho mình / đặt hộ..."
            options=null
        }}


        {{> forms/select
            id="trangThaiDon"
            name="trangThaiDon"
            label="Trạng thái đơn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn trạng thái đơn..."
            options=null
        }}

    {{/bao-cao/report-frame}}

</main>


<script
    defer
    src="{{asset "/assets/js/pages/bao-cao/dat-mon/dh07.js" }}">
</script>