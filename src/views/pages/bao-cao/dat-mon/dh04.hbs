<main
    class="dh04-page"
    data-dh04-page>

    {{#> bao-cao/report-frame
        maBaoCao=maBaoCao
        tenBaoCao=tenBaoCao
    }}

        {{> forms/date
            id="ngayNhan"
            name="ngayNhan"
            label="Ngày nhận dự kiến"
            placeholder="Chọn ngày nhận dự kiến..."
            defaultTime="00:00:00"
            required=true
        }}


        {{> forms/select
            id="coSoIds"
            name="coSoIds"
            label="Cơ sở"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn cơ sở..."
            options=null
        }}


        {{> forms/select
            id="nhaAnIds"
            name="nhaAnIds"
            label="Nhà ăn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn nhà ăn..."
            options=null
        }}


        {{> forms/select
            id="khungGioNhanIds"
            name="khungGioNhanIds"
            label="Khung giờ nhận"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn khung giờ nhận..."
            options=null
        }}


        {{> forms/select
            id="diaDiemNhanIds"
            name="diaDiemNhanIds"
            label="Địa điểm nhận"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn địa điểm nhận..."
            options=null
        }}


        {{> forms/select
            id="trangThaiDon"
            name="trangThaiDon"
            label="Trạng thái đơn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn trạng thái đơn..."
            options=null
        }}


        {{> forms/select
            id="nguoiXuLyIds"
            name="nguoiXuLyIds"
            label="Người xử lý"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn người xử lý..."
            options=null
        }}

    {{/bao-cao/report-frame}}

</main>


<script
    defer
    src="{{asset "/assets/js/pages/bao-cao/dat-mon/dh04.js" }}">
</script>