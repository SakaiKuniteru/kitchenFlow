<main
    class="dh01-page"
    data-dh01-page>


    {{#> bao-cao/report-frame
        maBaoCao=maBaoCao
        tenBaoCao=tenBaoCao
    }}


        {{> forms/select
            id="loaiThoiGian"
            name="loaiThoiGian"
            label="Khoảng thời gian"
            mode="single"
            multiple=false
            allowAll=false
            placeholder="Chọn ngày đặt / ngày nhận dự kiến..."
            options=null
            required=true
        }}


        {{> forms/date
            id="tuNgay"
            name="tuNgay"
            label="Từ ngày"
            placeholder="Nhập từ ngày..."
            defaultTime="00:00:00"
            showTime=true
            required=true
        }}


        {{> forms/date
            id="denNgay"
            name="denNgay"
            label="Đến ngày"
            placeholder="Nhập đến ngày..."
            defaultTime="23:59:59"
            showTime=true
            required=true
        }}


        {{> forms/select
            id="coSoIds"
            name="coSoIds"
            label="Cơ sở"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn cơ sở..."
            options=null
        }}


        {{> forms/select
            id="nhaAnIds"
            name="nhaAnIds"
            label="Nhà ăn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn nhà ăn..."
            options=null
        }}


        {{> forms/select
            id="trangThaiDon"
            name="trangThaiDon"
            label="Trạng thái đơn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn trạng thái đơn..."
            options=null
        }}


        {{> forms/select
            id="phuongThucThanhToan"
            name="phuongThucThanhToan"
            label="Phương thức thanh toán"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn phương thức thanh toán..."
            options=null
        }}


        {{> forms/select
            id="trangThaiThanhToan"
            name="trangThaiThanhToan"
            label="Trạng thái thanh toán"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn trạng thái thanh toán..."
            options=null
        }}


    {{/bao-cao/report-frame}}


</main>


<script
    defer
    src="{{asset "/assets/js/pages/bao-cao/dat-mon/dh01.js" }}">
</script>