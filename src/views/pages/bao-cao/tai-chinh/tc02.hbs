<main
    class="tc02-page"
    data-tc02-page
>

    {{#> bao-cao/report-frame
        maBaoCao=maBaoCao
        tenBaoCao=tenBaoCao
    }}


        {{> forms/date
            id="tuNgay"
            name="tuNgay"
            label="Từ ngày thanh toán"
            placeholder="Nhập từ ngày..."
            defaultTime="00:00:00"
            showTime=true
            required=true
        }}


        {{> forms/date
            id="denNgay"
            name="denNgay"
            label="Đến ngày thanh toán"
            placeholder="Nhập đến ngày..."
            defaultTime="23:59:59"
            showTime=true
            required=true
        }}


        {{> forms/select
            id="coSoIds"
            name="coSoIds"
            label="Cơ sở"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn cơ sở..."
            options=null
        }}


        {{> forms/select
            id="nhaAnIds"
            name="nhaAnIds"
            label="Nhà ăn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn nhà ăn..."
            options=null
        }}


        {{> forms/select
            id="nguonThanhToan"
            name="nguonThanhToan"
            label="Nguồn"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn nguồn..."
            options=null
        }}


        {{> forms/select
            id="hinhThucThanhToan"
            name="hinhThucThanhToan"
            label="Phương thức thanh toán"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn phương thức thanh toán..."
            options=null
        }}


        {{> forms/select
            id="trangThaiThanhToan"
            name="trangThaiThanhToan"
            label="Trạng thái thanh toán"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn trạng thái thanh toán..."
            options=null
        }}


        {{> forms/select
            id="thuNganIds"
            name="thuNganIds"
            label="Người thu tiền"
            mode="multiple"
            multiple=true
            allowAll=true
            allLabel="Tất cả"
            placeholder="Chọn người thu tiền..."
            options=null
        }}


    {{/bao-cao/report-frame}}

</main>


<script
    defer
    src="{{asset "/assets/js/pages/bao-cao/tai-chinh/tc02.js" }}"
></script>