<link
    rel="stylesheet"
    href="{{asset "/assets/css/common/data-list-page.css" }}"
>

<link
    rel="stylesheet"
    href="{{asset "/assets/css/catalog/pagination.css" }}"
>


{{#> dat-hang/dung-chung
    type="page-shell"
    page="my-orders"
}}

    <div class="order-heading-actions">

        {{> dat-hang/dung-chung
            type="page-header"
            title="Đơn hàng của tôi"
        }}

        <div class="order-action-row">

            <button
                type="button"
                class="order-button order-button--outline"
                data-orders-refresh>

                <i class="fa-solid fa-rotate"></i>

                Làm mới

            </button>


            <button
                type="button"
                class="order-button order-button--outline"
                data-toggle-filters
                aria-expanded="false">

                <i class="fa-solid fa-filter"></i>

                Bộ lọc

            </button>


            <a
                class="order-button order-button--primary"
                href="/dat-hang/dat-mon">

                Đặt món mới

            </a>

        </div>

    </div>


    <div
        class="order-data-list"
        data-order-list-common>

        {{> common/data-list/data-card
            listPage=listPage
        }}


        {{> common/data-list/filter
            listPage=listPage
        }}

    </div>

{{/dat-hang/dung-chung}}