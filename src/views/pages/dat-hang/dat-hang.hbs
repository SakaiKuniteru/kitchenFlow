<link
    rel="stylesheet"
    href="{{asset "/assets/css/catalog/pagination.css" }}"
>


{{#> dat-hang/dung-chung
    type="page-shell"
    page="catalog"
}}

    <div class="order-catalog-layout">

        <main class="order-catalog-main">

            <div class="order-catalog-heading">

                {{> dat-hang/dung-chung
                    type="page-header"
                    title="Đặt món"
                }}

            </div>


            {{> dat-hang/dat-mon
                type="search"
            }}


            <div
                class="order-category-tabs"
                data-category-tabs>
            </div>


            <div
                class="order-product-grid"
                data-product-grid>

                {{> dat-hang/dung-chung
                    type="loading"
                }}

            </div>


            {{!--
                Phân trang PHẢI nằm trong main.

                Như vậy chiều cao giỏ hàng bên phải
                không còn đẩy pagination xuống.
            --}}

            <div
                class="order-pagination-wrap"
                data-order-catalog-pagination>

                {{> catalog/pagination
                    paginationId="orderCatalogPagination"
                }}

            </div>

        </main>


        <aside
            class="order-cart-panel"
            data-cart-panel>

            {{> dat-hang/gio-hang
                type="empty"
            }}

        </aside>

    </div>


    {{> dat-hang/dat-mon
        type="filter"
    }}


    {{> dat-hang/dung-chung
        type="benefits"
    }}

{{/dat-hang/dung-chung}}