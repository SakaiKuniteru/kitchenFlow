<link
    rel="stylesheet"
    href="{{asset "/assets/css/common/data-list-page.css" }}"
>

<link
    rel="stylesheet"
    href="{{asset "/assets/css/catalog/pagination.css" }}"
>


{{#> dat-hang/dung-chung
    type="page-shell"
    page="management"
}}

    <div class="order-heading-actions">

        {{> dat-hang/dung-chung
            type="page-header"
            title="Nhận đơn hàng"
        }}


        <div class="order-action-row">

            <button
                type="button"
                class="order-button order-button--outline"
                data-orders-refresh
            >
                <i class="fa-solid fa-rotate"></i>
                Làm mới
            </button>


            <div class="order-filter-anchor">

                <button
                    type="button"
                    class="order-button order-button--outline"
                    data-toggle-filters
                    aria-expanded="false"
                >
                    <i class="fa-solid fa-filter"></i>
                    Bộ lọc
                </button>


                {{> common/data-list/filter
                    listPage=listPage
                }}

            </div>


            <button
                type="button"
                class="order-button order-button--primary"
                data-management-export
            >
                <i class="fa-solid fa-download"></i>
                Xuất dữ liệu
            </button>

        </div>

    </div>


    {{#> dat-hang/dung-chung
        type="management-layout"
    }}

        <div
            class="order-stat-grid"
            data-management-stats
        >
        </div>


        <div
            class="order-data-list"
            data-order-list-common
        >

            {{> common/data-list/data-card
                listPage=listPage
            }}

        </div>

    {{/dat-hang/dung-chung}}


    {{> dat-hang/chi-tiet
        type="dialog"
    }}

{{/dat-hang/dung-chung}}