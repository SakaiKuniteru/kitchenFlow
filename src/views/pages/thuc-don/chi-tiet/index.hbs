<link
    rel="stylesheet"
    href="/assets/css/pages/thuc-don/chi-tiet.css">

<section
    class="thuc-don-detail"
    data-thuc-don-detail
    data-thuc-don-id="{{thucDonId}}">

    <header class="thuc-don-detail__header">

        <div class="thuc-don-detail__heading">

            <div class="thuc-don-detail__heading-top">

                <a
                    href="/thuc-don/danh-sach-thuc-don"
                    class="thuc-don-detail__back"
                    title="Quay lại danh sách">

                    <i class="fa-solid fa-arrow-left"></i>

                </a>

                <div>

                    <div class="thuc-don-detail__code">
                        <span data-detail-code>
                            —
                        </span>

                        <span
                            class="thuc-don-detail__status"
                            data-detail-status>
                            —
                        </span>
                    </div>

                    <h1
                        class="thuc-don-detail__title"
                        data-detail-name>
                        Đang tải thông tin thực đơn...
                    </h1>

                </div>

            </div>

        </div>


        <div class="thuc-don-detail__header-actions">

            <button
                type="button"
                class="
                    thuc-don-detail__action
                    is-print
                "
                data-detail-print>

                <i class="fa-solid fa-print"></i>

                <span>
                    In thực đơn
                </span>

            </button>


            <button
                type="button"
                class="
                    thuc-don-detail__action
                    is-delete
                "
                data-detail-delete>

                <i class="fa-regular fa-trash-can"></i>

                <span>
                    Xóa
                </span>

            </button>

        </div>

    </header>


    <section class="thuc-don-detail__card">

        <div class="thuc-don-detail__section-header">

            <div>

                <h2 class="thuc-don-detail__section-title">
                    Thông tin thực đơn
                </h2>

                <p class="thuc-don-detail__section-description">
                    Thông tin chung và phạm vi áp dụng của thực đơn.
                </p>

            </div>


        <div class="thuc-don-detail__workflow-actions">

            <div
                class="thuc-don-detail__view-actions"
                data-detail-view-actions>

                <button
                    type="button"
                    class="
                        thuc-don-detail__small-action
                        is-edit
                    "
                    data-detail-edit
                    hidden>

                    <i class="fa-regular fa-pen-to-square"></i>

                    <span>
                        Chỉnh sửa
                    </span>

                </button>

                <button
                    type="button"
                    class="
                        thuc-don-detail__small-action
                        is-approve
                    "
                    data-detail-approve
                    hidden>

                    <i class="fa-solid fa-check"></i>

                    <span>
                        Duyệt
                    </span>

                </button>

                <button
                    type="button"
                    class="
                        thuc-don-detail__small-action
                        is-cancel
                    "
                    data-detail-cancel
                    hidden>

                    <i class="fa-solid fa-ban"></i>

                    <span>
                        Hủy thực đơn
                    </span>

                </button>

            </div>


            <div
                class="thuc-don-detail__editing-actions"
                data-detail-editing-actions
                hidden>

                <button
                    type="button"
                    class="
                        thuc-don-detail__edit-action
                        is-cancel
                    "
                    data-edit-cancel>

                    <i class="fa-solid fa-xmark"></i>

                    <span>
                        Hủy
                    </span>

                </button>

                <button
                    type="button"
                    class="
                        thuc-don-detail__edit-action
                        is-save
                    "
                    data-edit-save>

                    <i class="fa-solid fa-check"></i>

                    <span>
                        Lưu thay đổi
                    </span>

                </button>

            </div>

        </div>

        </div>

        <div data-detail-view> 
            <div class="thuc-don-detail__information-grid">

                    <div class="thuc-don-detail__information">

                        <span class="thuc-don-detail__label">
                            Mã thực đơn
                        </span>

                        <strong data-detail-ma>
                            —
                        </strong>

                    </div>


                    <div class="thuc-don-detail__information">

                        <span class="thuc-don-detail__label">
                            Tên thực đơn
                        </span>

                        <strong data-detail-ten>
                            —
                        </strong>

                    </div>


                    <div class="thuc-don-detail__information">

                        <span class="thuc-don-detail__label">
                            Loại thực đơn
                        </span>

                        <strong data-detail-loai>
                            —
                        </strong>

                    </div>


                    <div class="thuc-don-detail__information">

                        <span class="thuc-don-detail__label">
                            Trạng thái
                        </span>

                        <strong data-detail-trang-thai>
                            —
                        </strong>

                    </div>


                    <div class="thuc-don-detail__information">

                        <span class="thuc-don-detail__label">
                            Từ ngày
                        </span>

                        <strong data-detail-tu-ngay>
                            —
                        </strong>

                    </div>


                    <div class="thuc-don-detail__information">

                        <span class="thuc-don-detail__label">
                            Đến ngày
                        </span>

                        <strong data-detail-den-ngay>
                            —
                        </strong>

                    </div>


                    <div class="thuc-don-detail__information">

                        <span class="thuc-don-detail__label">
                            Cơ sở
                        </span>

                        <strong data-detail-co-so>
                            —
                        </strong>

                    </div>


                    <div class="thuc-don-detail__information">

                        <span class="thuc-don-detail__label">
                            Nhà ăn
                        </span>

                        <strong data-detail-nha-an>
                            —
                        </strong>

                    </div>


                    <div class="thuc-don-detail__information">

                        <span class="thuc-don-detail__label">
                            Ca ăn
                        </span>

                        <strong data-detail-ca-an>
                            —
                        </strong>

                    </div>


                    <div class="thuc-don-detail__information">

                        <span class="thuc-don-detail__label">
                            Hiệu lực
                        </span>

                        <strong data-detail-active>
                            —
                        </strong>

                    </div>


                    <div
                        class="
                            thuc-don-detail__information
                            is-full
                        ">

                        <span class="thuc-don-detail__label">
                            Mô tả
                        </span>

                        <div data-detail-mo-ta>
                            —
                        </div>

                    </div>

                </div>
        </div>

        <div
            class="thuc-don-detail__edit"
            data-detail-edit-form
            hidden>

            <div class="thuc-don-detail__edit-grid">

                {{> forms/input
                    id="editMaThucDon"
                    name="maThucDon"
                    label="Mã thực đơn"
                    required=true
                }}


                {{> forms/input
                    id="editTenThucDon"
                    name="tenThucDon"
                    label="Tên thực đơn"
                    required=true
                }}


                {{> forms/select
                    id="editLoaiThucDon"
                    name="loaiThucDon"
                    label="Loại thực đơn"
                    mode="single"
                    placeholder="Chọn loại thực đơn..."
                    options=formOptions.loaiThucDon
                }}

                {{> forms/date
                    id="editTuNgay"
                    name="tuNgay"
                    label="Từ ngày"
                    showTime=false
                    required=true
                }}

                {{> forms/date
                    id="editDenNgay"
                    name="denNgay"
                    label="Đến ngày"
                    showTime=false
                    required=true
                }}


                {{> forms/select
                    id="editCoSoId"
                    name="coSoId"
                    label="Cơ sở"
                    mode="single"
                    placeholder="Chọn cơ sở..."
                }}


                {{> forms/select
                    id="editNhaAnId"
                    name="nhaAnId"
                    label="Nhà ăn"
                    mode="single"
                    placeholder="Chọn nhà ăn..."
                }}


                {{> forms/select
                    id="editCaAnId"
                    name="caAnId"
                    label="Ca ăn"
                    mode="single"
                    placeholder="Chọn ca ăn..."
                }}


                <div class="thuc-don-detail__edit-full">

                    {{> forms/textarea
                        id="editMoTa"
                        name="moTa"
                        label="Mô tả"
                        rows=3
                        maxlength=500
                        showCounter=true
                    }}

                </div>

            </div>

        </div>
                

    </section>


    <section class="thuc-don-detail__card">

        <div class="thuc-don-detail__section-header">

            <div>

                <h2 class="thuc-don-detail__section-title">
                    Nội dung thực đơn
                </h2>

                <p class="thuc-don-detail__section-description">
                    Danh sách món ăn được sắp xếp theo ngày và nhóm món ăn.
                </p>

            </div>

        </div>


        <div data-detail-content-view>

            <div
                class="thuc-don-detail__days"
                data-detail-days>
            </div>

            <div
                class="thuc-don-detail__empty"
                data-detail-empty
                hidden>

                <i class="fa-regular fa-calendar-xmark"></i>

                <strong>
                    Chưa có nội dung thực đơn
                </strong>

                <span>
                    Thực đơn này chưa được cấu hình món ăn.
                </span>

            </div>

        </div>


        <div
            class="thuc-don-detail__content-edit"
            data-detail-content-edit
            hidden>

            <div
                class="thuc-don-detail__content-edit-days"
                data-edit-days>
            </div>

        </div>

    </section>

</section>


<script
    defer
    src="/assets/js/pages/thuc-don/chi-tiet.js">
</script>