<link
    rel="stylesheet"
    href="/assets/css/pages/thuc-don/forms.css">

<link
    rel="stylesheet"
    href="/assets/css/pages/thuc-don/chi-tiet.css">


<section
    class="thuc-don-detail"
    data-thuc-don-detail
    data-thuc-don-id="{{thucDonId}}">

    <header class="thuc-don-detail__page-header">

        <div>

            <h1 class="thuc-don-detail__title">

                <i class="fa-regular fa-calendar-check"></i>

                <span>
                    Chi tiết thực đơn
                </span>

            </h1>


            <p class="thuc-don-detail__subtitle">
                Xem thông tin chi tiết và nội dung của thực đơn.
            </p>

        </div>


        <div class="thuc-don-detail__page-actions">

            <a
                href="/thuc-don/cap-nhat-thong-tin-thuc-don/{{thucDonId}}"
                class="
                    thuc-don-detail__action
                    is-edit
                "
                data-detail-edit
                hidden>

                <i class="fa-regular fa-pen-to-square"></i>

                <span>
                    Chỉnh sửa
                </span>

            </a>


            <button
                type="button"
                class="
                    thuc-don-detail__action
                    is-approve
                "
                data-detail-approve
                hidden>

                <i class="fa-solid fa-check"></i>

                <span>
                    Duyệt
                </span>

            </button>


            <button
                type="button"
                class="
                    thuc-don-detail__action
                    is-unapprove
                "
                data-detail-unapprove
                hidden>

                <i class="fa-solid fa-rotate-left"></i>

                <span>
                    Hủy duyệt
                </span>

            </button>


            <button
                type="button"
                class="
                    thuc-don-detail__action
                    is-cancel
                "
                data-detail-cancel
                hidden>

                <i class="fa-solid fa-ban"></i>

                <span>
                    Hủy thực đơn
                </span>

            </button>


            <button
                type="button"
                class="
                    thuc-don-detail__action
                    is-restore
                "
                data-detail-restore
                hidden>

                <i class="fa-solid fa-arrow-rotate-left"></i>

                <span>
                    Hoàn hủy
                </span>

            </button>

        </div>

    </header>


    <div
        class="thuc-don-form"
        data-thuc-don-form
        data-form-mode="detail"
        data-thuc-don-id="{{thucDonId}}">

        <div
            hidden
            data-thuc-don-options>

            {{#each formOptions.loaiThucDon}}

                <span
                    data-loai-thuc-don-option
                    data-value="{{value}}"
                    data-label="{{label}}">
                </span>

            {{/each}}


            {{#each formOptions.trangThai}}

                <span
                    data-trang-thai-option
                    data-value="{{value}}"
                    data-label="{{label}}">
                </span>

            {{/each}}

        </div>


        {{> thuc-don/thong-tin-chung}}

        <section class="thuc-don-form__content">

            <div class="thuc-don-form__menu-layout">

                {{> thuc-don/ngay}}

                {{> thuc-don/nhom-mon}}

                {{> thuc-don/mon-an}}

            </div>

        </section>

    </div>

</section>


<script src="/assets/js/pages/thuc-don/forms.js"></script>

<script src="/assets/js/pages/thuc-don/chi-tiet.js"></script>
