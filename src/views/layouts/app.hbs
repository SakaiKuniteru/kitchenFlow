<!DOCTYPE html>

<html lang="vi">

<head>

    {{> common/head}}

    <link
        rel="stylesheet"
        href="/assets/css/common/reset.css">

    <link
        rel="stylesheet"
        href="/assets/css/common/variables.css">

    <link
        rel="stylesheet"
        href="/assets/css/common/layout.css">

    <link
        rel="stylesheet"
        href="/assets/css/common/header.css">

    <link
        rel="stylesheet"
        href="/assets/css/common/sidebar.css">

    <link
        rel="stylesheet"
        href="/assets/css/common/footer.css">

    <link
        rel="stylesheet"
        href="/assets/css/common/modal.css">

    <link
        rel="stylesheet"
        href="/assets/css/common/toast.css">

    <link
        rel="stylesheet"
        href="/assets/css/common/loading.css">

    <link rel="stylesheet" href="/assets/css/components/date-picker.css">

    <link
        rel="stylesheet"
        href="/assets/css/components/smart-select.css">


    {{#if isCatalogPage}}

        <link
            rel="stylesheet"
            href="/assets/css/catalog/catalog.css">

        <link
            rel="stylesheet"
            href="/assets/css/catalog/toolbar.css">

        <link
            rel="stylesheet"
            href="/assets/css/catalog/table.css">

        <link
            rel="stylesheet"
            href="/assets/css/catalog/detail-panel.css">

        <link
            rel="stylesheet"
            href="/assets/css/catalog/form.css">

        <link
            rel="stylesheet"
            href="/assets/css/catalog/pagination.css">

        <link
            rel="stylesheet"
            href="/assets/css/catalog/mobile.css">

    {{/if}}

</head>

<body>

    {{> common/loading}}

    <div id="app">

        {{> common/header}}

        <div class="app-wrapper">

            {{> common/sidebar}}

            <main class="app-content">

                {{> common/breadcrumb}}

                <section class="page-content">

                    {{{body}}}

                </section>

                {{> common/footer}}

            </main>

        </div>

    </div>

    {{> common/toast}}

    {{> modals/alert}}

    {{> modals/confirm}}

    {{> modals/change-password}}

    {{> modals/employee-profile
        formOptions=formOptions}}


    {{!-- ==================================================
         JavaScript dùng chung
         ================================================== --}}

    <script defer src="/assets/js/common/app.js"></script>
    
    <script defer src="/assets/js/components/date-picker.js"></script>

    <script defer src="/assets/js/components/smart-select.js"></script>
    
    <script defer src="/assets/js/common/header.js"></script>

    <script defer src="/assets/js/common/sidebar.js"></script>

    <script defer src="/assets/js/common/modal.js"></script>

    <script defer src="/assets/js/common/toast.js"></script>

    <script defer src="/assets/js/common/loading.js"></script>

    <script defer src="/assets/js/common/change-password.js"></script>

</body>

</html>